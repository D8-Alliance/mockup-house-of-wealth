# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Backend (server/) - NestJS + Prisma (Postgres) + OIDC identity
# ---------------------------------------------------------------------------

# Postgres connection string for Prisma (migrate/push and runtime client).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/house_of_wealth?schema=public"

# Identity mode. "mock" accepts any well-formed token in dev without an IdP.
# Set to "oidc" once an IdP (Auth0 / Entra / Keycloak / Okta) is wired up.
AUTH_MODE="mock"

# OIDC / JWT verification (used when AUTH_MODE != "mock").
OIDC_AUDIENCE="house-of-wealth-api"
OIDC_JWKS_URI="https://YOUR_TENANT.example/.well-known/jwks.json"
# OIDC_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----..."  # alternative to JWKS
JWT_SHARED_SECRET="dev-only-change-me"  # HS256 for local development only

# Server listens on this port.
PORT="3001"

# Tenant scoping defaults (used in mock/dev mode).
DEFAULT_COUNTRY_NODE="CN-MYS"
DEFAULT_ORGANISATION="ORG-PUBLIC"
