 "GET /projects/PROJ-DEMO-MYS-AGRI-001/documents": {
  "status": 200,
  "contentType": "application/json; charset=utf-8",
  "body": "[{\"id\":\"DEMO-DOC-009\",\"projectId\":\"PROJ-DEMO-MYS-AGRI-001\",\"fileName\":\"DEMO-09-Permits-and-Approvals-Matrix.pdf\",\"mimeType\":\"application/pdf\",\"fileSize\":245,\"extractionStatus\":\"EXTRACTED\",\"extractionError\":null,\"extractedText\":\"DEMO / SIMULATION ONLY. Synthetic permits matrix covering planning, environmental, fire safety, food handling and occupational safety approvals. No authority has issued or verified these documents. Statuses are placeholders for workflow testing.\",\"uploadedBy\":\"USR-MYS-P2-001\",\"createdAt\":\"2026-09-30T02:47:37.621Z\",\"updatedAt\":\"2026-09-30T02:47:37.621Z\"},{\"id\":\"DEMO-DOC-008\",\"projectId\":\"PROJ-DEMO-MYS-AGRI-001\",\"fileName\":\"DEMO-08-Risk-and-Due-Diligence-Register.pdf\",\"mimeType\":\"application/pdf\",\"fileSize\":310,\"extractionStatus\":\"EXTRACTED\",\"extractionError\":null,\"extractedText\":\"DEMO / SIMULATION ONLY. Synthetic risk register. Key risks include construction delay, commodity price volatility, utilisation shortfall, weather exposure, counterparty default and regulatory approval. All checks are marked DEMO_VERIFIED for testing only and require real-world replacement before any decision.\",\"uploadedBy\":\"USR-MYS-P2-001\",\"createdAt\":\"2026-09-30T02:47:37.612Z\",\"updatedAt\":\"2026-09-30T02:47:37.612Z\"},{\"id\":\"DEMO-DOC-007\",\"projectId\":\"PROJ-DEMO-MYS-AGRI-001\",\"fileName\":\"DEMO-07-Shariah-Structuring-Memorandum.pdf\",\"mimeType\":\"application/pdf\",\"fileSize\":267,\"extractionStatus\":\"EXTRACTED\",\"extractionError\":null,\"extractedText\":\"DEMO / SIMULATION ONLY. Synthetic preliminary memorandum. Musharakah is used as the proposed structure for testing because capital participation, ownership, profit allocation and loss allocation can be modelled. This is not a fatwa, Shariah approval or legal opinion.\",\"uploadedBy\":\"USR-MYS-P2-001\",\"createdAt\":\"2026-09-30T02:47:37.602Z\",\"updatedAt\":\"2026-09-30T02:47:37.602Z\"},{\"id\":\"DEMO-DOC-006\",\"projectId\":\"PROJ-DEMO-MYS-AGRI-001\",\"fileName\":\"DEMO-06-Cashflow-and-Sources-of-Funds.pdf\",\"mimeType\":\"application/pdf\",\"fileSize\":310,\"extractionStatus\":\"EXTRACTED\",\"extractionError\":null,\"extractedText\":\"DEMO / SIMULATION ONLY. Synthetic cashflow evidence. Construction drawdown is assumed across 18 months. The fictional sponsor contribution is MYR 7 million and requested project funding is MYR 25 million. Bank statements, source-of-funds evidence and independent confirmations do not exist for this simulation.\",\"uploadedBy\":\"USR-MYS-P2-001\",\"createdAt\":\"2026-09-30T02:47:37.595Z\",\"updatedAt\":\"2026-09-30T02:47:37.595Z\"},{\"id\":\"DEMO-DOC-005\",\"projectId\":\"PROJ-DEMO-MYS-AGRI-001\",\"fileName\":\"DEMO-05-Five-Year-Financial-Model.pdf\",\"mimeType\":\"application/pdf\",\"fileSize\":297,\"extractionStatus\":\"EXTRACTED\",\"extractionError\":null,\"extractedText\":\"DEMO / SIMULATION ONLY. Synthetic financial model. Illustrative revenue is MYR 14.2 million in Year 1 increasing to MYR 28.6 million in Year 5. Illustrative EBITDA margin ranges from 24% to 31%. These figures are assumptions for testing and are not forecasts, audited results or investment advice.\",\"uploadedBy\":\"USR-MYS-P2-001\",\"createdAt\":\"2026-09-30T02:47:37.584Z\",\"updatedAt\":\"2026-09-30T02:47:37.584Z\"},{\"id\":\"DEMO-DOC-004\",\"projectId\":\"PROJ-DEMO-MYS-AGRI-001\",\"fileName\":\"DEMO-04-Feasibility-and-Market-Study.pdf\",\"mimeType\":\"application/pdf\",\"fileSize\":282,\"extractionStatus\":\"EXTRACTED\",\"extractionError\":null,\"extractedText\":\"DEMO / SIMULATION ONLY. Synthetic market study for testing. Assumed customers, storage utilisation, commodity throughput, pricing, logistics costs and offtake assumptions are illustrative. No customer, supplier, offtake agreement or market statistic has been independently verified.\",\"uploadedBy\":\"USR-MYS-P2-001\",\"createdAt\":\"2026-09-30T02:47:37.578Z\",\"updatedAt\":\"2026-09-30T02:47:37.578Z\"},{\"id\":\"DEMO-DOC-003\",\"projectId\":\"PROJ-DEMO-MYS-AGRI-001\",\"fileName\":\"DEMO-03-Land-and-Asset-Schedule.pdf\",\"mimeType\":\"application/pdf\",\"fileSize\":295,\"extractionStatus\":\"EXTRACTED\",\"extractionError\":null,\"extractedText\":\"DEMO / SIMULATION ONLY. Synthetic asset schedule covering a fictional 18-acre industrial site, grain silos, dryers, cold rooms and handling machinery. The stated asset values are illustrative only. No title, valuation, charge search or ownership claim in this document is genuine or enforceable.\",\"uploadedBy\":\"USR-MYS-P2-001\",\"createdAt\":\"2026-09-30T02:47:37.568Z\",\"updatedAt\":\"2026-09-30T02:47:37.568Z\"},{\"id\":\"DEMO-DOC-002\",\"projectId\":\"PROJ-DEMO-MYS-AGRI-001\",\"fileName\":\"DEMO-02-Corporate-Profile-and-UBO.pdf\",\"mimeType\":\"application/pdf\",\"fileSize\":370,\"extractionStatus\":\"EXTRACTED\",\"extractionError\":null,\"extractedText\":\"DEMO / SIMULATION ONLY. Synthetic corporate profile for testing. The fictional sponsor is Selangor Precision Agri Storage Sdn. Bhd. Fictional directors, beneficial owners, registration numbers and identity references are placeholders and have no legal effect. KYB status is DEMO_VERIFIED only within the application fixture and has not been checked against any registry.\",\"uploadedBy\":\"USR-MYS-P2-001\",\"createdAt\":\"2026-09-30T02:47:37.560Z\",\"updatedAt\":\"2026-09-30T02:47:37.560Z\"},{\"id\":\"DEMO-DOC-001\",\"projectId\":\"PROJ-DEMO-MYS-AGRI-001\",\"fileName\":\"DEMO-01-Project-Information-Memorandum.pdf\",\"mimeType\":\"application/pdf\",\"fileSize\":412,\"extractionStatus\":\"EXTRACTED\",\"extractionError\":null,\"extractedText\":\"DEMO / SIMULATION ONLY. Not a real investment opportunity. Selangor Precision Agri-Tech & Grain Storage is a synthetic MYR 32 million grain handling, cold storage and precision farming project. The proposed funding requirement is MYR 25 million and sponsor contribution is MYR 7 million. All names, figures, registrations, contracts and financial information in this document are fabricated for software testing.\",\"uploadedBy\":\"USR-MYS-P2-001\",\"createdAt\":\"2026-09-30T02:47:37.543Z\",\"updatedAt\":\"2026-09-30T02:47:37.543Z\"}]"
 },
