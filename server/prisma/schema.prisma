  status           String    @default("DRAFT")
  wizardData       Json?
  complianceReport Json?
  lastGeneratedAt  DateTime?
  organisationId   String
  countryNodeId    String
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organisation     Organisation       @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode      CountryNode        @relation(fields: [countryNodeId], references: [code])
  versions         ContractVersion[]
  parties          ContractParty[]
  approvals        ContractApproval[]
  events           ContractEvent[]
  documentVersions DocumentVersion[]

  @@index([organisationId, countryNodeId])
  @@index([status])
  @@index([contractType, status])
}

// ---------------------------------------------------------------------------
// Contract Intelligence Engine foundation
// ---------------------------------------------------------------------------

model ContractTemplate {
  id             String   @id @default(cuid())
  organisationId String
  countryNodeId  String
  contractType   String
  templateName   String
  jurisdiction   String
  industry       String
  version        Int      @default(1)
  status         String   @default("ACTIVE")
  approvalStatus String   @default("PENDING")
  createdBy      String
  createdDate    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation     @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode      @relation(fields: [countryNodeId], references: [code])
  creator      User             @relation(fields: [createdBy], references: [id])
  clauses      ContractClause[]

  @@unique([organisationId, countryNodeId, contractType, templateName, version])
  @@index([organisationId, countryNodeId, contractType, approvalStatus])
  @@index([jurisdiction, industry])
}

model ContractClause {
  id               String   @id @default(cuid())
  organisationId   String
  countryNodeId    String
  templateId       String?
  contractType     String
  industry         String?
  clauseCategory   String
  clauseTitle      String
  clauseText       String   @db.Text
  shariahReference String?
  jurisdiction     String
  riskLevel        String   @default("MEDIUM")
  approvalStatus   String   @default("PENDING")
  createdBy        String
  createdDate      DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organisation Organisation      @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode       @relation(fields: [countryNodeId], references: [code])
  template     ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  creator      User              @relation(fields: [createdBy], references: [id])

  @@index([organisationId, countryNodeId, contractType, approvalStatus])
  @@index([templateId])
  @@index([industry])
}

model ContractInputSchema {
  id             String   @id @default(cuid())
  organisationId String
  countryNodeId  String
  contractType   String
  schemaName     String
  version        Int      @default(1)
  requiredFields Json
  status         String   @default("ACTIVE")
  approvalStatus String   @default("PENDING")
  createdBy      String
  createdDate    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode  @relation(fields: [countryNodeId], references: [code])
  creator      User         @relation(fields: [createdBy], references: [id])

  @@unique([organisationId, countryNodeId, contractType, schemaName, version])
  @@index([organisationId, countryNodeId, contractType, approvalStatus])
}

model ShariahRule {
  id              String   @id @default(cuid())
  organisationId  String
  countryNodeId   String
  contractType    String
  jurisdiction    String?
  ruleName        String
  description     String   @db.Text
  severity        String   @default("MEDIUM")
  validationLogic String   @db.Text
  approvalStatus  String   @default("PENDING")
  createdBy       String
  createdDate     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode  @relation(fields: [countryNodeId], references: [code])
  creator      User         @relation(fields: [createdBy], references: [id])

  @@unique([organisationId, countryNodeId, contractType, ruleName])
  @@index([organisationId, countryNodeId, contractType, severity, approvalStatus])
  @@index([jurisdiction])
}

model DocumentVersion {
  id             String   @id @default(cuid())
  documentId     String
  organisationId String
  countryNodeId  String
  version        Int
  createdBy      String
  reviewStatus   String   @default("DRAFT")
  approvedBy     String?
  createdDate    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  document     Contract     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode  @relation(fields: [countryNodeId], references: [code])
  creator      User         @relation("DocumentVersionCreator", fields: [createdBy], references: [id])
  approver     User?        @relation("DocumentVersionApprover", fields: [approvedBy], references: [id], onDelete: Restrict)

  @@unique([documentId, version])
  @@index([organisationId, countryNodeId, reviewStatus])
  @@index([documentId, createdDate])
}

model ContractVersion {
  id         String   @id @default(cuid())
  contractId String
  version    Int
  content    Json
  status     String   @default("DRAFT")
  createdBy  String
  createdAt  DateTime @default(now())

  contract  Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  approvals ContractApproval[]

  @@unique([contractId, version])
}

model ContractParty {
  id             String   @id @default(cuid())
  contractId     String
  partyType      String
  displayName    String
  userId         String?
  organisationId String?
  createdAt      DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model ContractApproval {
  id           String    @id @default(cuid())
  contractId   String
  versionId    String
  approverId   String
  status       String    @default("PENDING")
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())

  contract Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  version  ContractVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([contractId, status])
}

model ContractEvent {
  id         String   @id @default(cuid())
  contractId String
  eventType  String
  fromStatus String?
  toStatus   String?
  actorId    String
  metadata   Json
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, createdAt])
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  activeRole     UserRole?
  countryNodeId  String
  organisationId String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

/// Tamper-evident hash chain over AuditEvent (chain AUDIT) and LedgerTransaction with its entries (chain LEDGER).
/// Append-only (database trigger). See src/audit/hash-chain.service.ts.
model HashChainLink {
  id           String   @id @default(cuid())
  chain        String
  sequence     Int
  recordId     String
  previousHash String
  hash         String
  sealedAt     DateTime @default(now())

  @@unique([chain, sequence])
  @@unique([chain, recordId])
}

/// Akad (Shariah contract) terms of a pool. Append-only (database trigger): a change is a new version,
/// and terms cannot change once an investor has accepted them. See src/pools/akad-terms.ts.
model PoolAkadTerms {
  id                     String   @id @default(cuid())
  poolId                 String
  version                Int
  akadType               String
  investorProfitSharePct Decimal  @db.Decimal(5, 2)
  termsText              String   @db.Text
  termsHash              String
  createdBy              String
  createdAt              DateTime @default(now())

  pool          WealthPool        @relation(fields: [poolId], references: [poolId], onDelete: Restrict)
  orders        InvestmentOrder[]
  distributions Distribution[]

  @@unique([poolId, version])
}
