// Wealth Pooling - Prisma schema (PostgreSQL)
// Persistence layer for the backend API.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

// Mirror of the frontend UserRole union so the policy engine and IdP mapping
// share a single server-side source of truth.
enum UserRole {
  Super_Admin
  Country_Admin
  Organization_Admin
  Project_Sponsor
  Project_Manager
  Asset_Owner
  Asset_Manager
  Pool_Manager
  Retail_Investor
  HNWI_Investor
  Institutional_Investor
  Corporate_Investor
  Family_Office
  Portfolio_Manager
  Shariah_Advisor
  Shariah_Reviewer
  Shariah_Committee
  Compliance_Officer
  KYC_Officer
  KYB_Officer
  AML_Officer
  Risk_Officer
  Fraud_Analyst
  Legal_Officer
  Finance_Officer
  Treasury_Officer
  Settlement_Officer
  Reconciliation_Officer
  Auditor
  Customer_Support
  System_Administrator
  Security_Administrator
  Data_Administrator
  AI_Administrator
  AI_Model_Reviewer
  Guest
}

// Users are provisioned from the Identity Provider (Auth0 / Entra / Keycloak / Okta)
// via their OIDC subject identifier. This table stores the server-side profile and
// role mapping only; authentication is delegated to the IdP.
model User {
  id           String   @id @default(cuid())
  idpProvider  String // 'auth0' | 'azure' | 'keycloak' | 'okta'
  idpSubjectId String // OIDC `sub` claim
  email        String   @unique
  name         String
  isActive     Boolean  @default(true)
  profile      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // User can have multiple roles per organisation/country node
  roleAssignments             UserRoleAssignment[]
  projectTeamMemberships      ProjectTeamMember[]
  sponsoredProjects           Project[]
  projectAnnouncements        ProjectAnnouncement[]
  promotionCampaigns          ProjectPromotionCampaign[]
  promotionPayments           PromotionPayment[]
  sessions                    Session[]
  createdContractTemplates    ContractTemplate[]
  createdContractClauses      ContractClause[]
  createdContractInputSchemas ContractInputSchema[]
  createdShariahRules         ShariahRule[]
  createdDocumentVersions     DocumentVersion[]          @relation("DocumentVersionCreator")
  approvedDocumentVersions    DocumentVersion[]          @relation("DocumentVersionApprover")

  @@unique([idpProvider, idpSubjectId])
  @@index([email])
}

// User role assignments are scoped to a specific organisation and country node.
// A user can have multiple roles within a single org/country, or roles across multiple orgs.
model UserRoleAssignment {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           UserRole
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  countryNodeId  String
  countryNode    CountryNode  @relation(fields: [countryNodeId], references: [code], onDelete: Cascade)
  assignedBy     String // userId of the admin who made this assignment
  assignedAt     DateTime     @default(now())
  revokedBy      String?
  revokedAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, role, organisationId, countryNodeId])
  @@index([role])
  @@index([countryNodeId])
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model CountryNode {
  code                     String   @id
  name                     String
  currency                 String
  timezone                 String
  regulatoryProfile        String
  status                   String
  verificationStatus       String
  activeOrganisationsCount Int      @default(0)
  activeUsersCount         Int      @default(0)
  activeProjectsCount      Int      @default(0)
  activePoolsCount         Int      @default(0)
  flagUrl                  String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organisations        Organisation[]
  projects             Project[]
  pools                WealthPool[]
  contracts            Contract[]
  shariahReviews       ShariahReview[]
  auditEvents          AuditEvent[]
  fundingRequests      FundingRequest[]
  userRoleAssignments  UserRoleAssignment[]
  projectDocuments     ProjectDocument[]
  evidenceRequirements ProjectEvidenceRequirement[]
  projectTeamMembers   ProjectTeamMember[]
  projectAnnouncements ProjectAnnouncement[]
  promotionCampaigns   ProjectPromotionCampaign[]
  dueDiligenceScans    ProjectDueDiligenceScan[]
  documentAnalyses     ProjectDocumentAnalysis[]
  projectMilestones    ProjectMilestone[]
  lifecycleEvents      ProjectLifecycleEvent[]
  feasibilityRevisions ProjectFeasibilityRevision[]
  approvals            ProjectApproval[]
  contractTemplates    ContractTemplate[]
  contractClauses      ContractClause[]
  contractInputSchemas ContractInputSchema[]
  shariahRules         ShariahRule[]
  documentVersions     DocumentVersion[]
  financialAccounts    FinancialAccount[]
  ledgerTransactions   LedgerTransaction[]
}

model Organisation {
  id            String      @id @default(cuid())
  name          String
  countryNodeId String
  countryNode   CountryNode @relation(fields: [countryNodeId], references: [code])
  status        String      @default("ACTIVE")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  projects             Project[]
  pools                WealthPool[]
  auditEvents          AuditEvent[]
  userRoleAssignments  UserRoleAssignment[]
  fundingRequests      FundingRequest[]
  contracts            Contract[]
  shariahReviews       ShariahReview[]
  projectDocuments     ProjectDocument[]
  evidenceRequirements ProjectEvidenceRequirement[]
  projectTeamMembers   ProjectTeamMember[]
  projectAnnouncements ProjectAnnouncement[]
  promotionCampaigns   ProjectPromotionCampaign[]
  dueDiligenceScans    ProjectDueDiligenceScan[]
  documentAnalyses     ProjectDocumentAnalysis[]
  projectMilestones    ProjectMilestone[]
  lifecycleEvents      ProjectLifecycleEvent[]
  contractTemplates    ContractTemplate[]
  contractClauses      ContractClause[]
  contractInputSchemas ContractInputSchema[]
  shariahRules         ShariahRule[]
  documentVersions     DocumentVersion[]
  feasibilityRevisions ProjectFeasibilityRevision[]
  approvals            ProjectApproval[]
  financialAccounts    FinancialAccount[]
  ledgerTransactions   LedgerTransaction[]

  @@unique([id, countryNodeId])
  @@index([countryNodeId])
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------

model Project {
  projectId               String   @id @default(cuid())
  projectCode             String   @unique
  projectName             String
  description             String
  organisationId          String
  countryNodeId           String
  sector                  String
  totalProjectCost        Decimal  @db.Decimal(18, 2)
  sponsorContribution     Decimal  @db.Decimal(18, 2)
  fundingRequired         Decimal  @db.Decimal(18, 2)
  proposedShariahContract String
  sponsorEntityType       String?
  status                  String
  projectSponsorId        String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  lifecycleVersion        Int      @default(1)

  organisation         Organisation                 @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode          CountryNode                  @relation(fields: [countryNodeId], references: [code])
  projectSponsor       User                         @relation(fields: [projectSponsorId], references: [id])
  pools                WealthPool[]
  fundingRequests      FundingRequest[]
  shariahReviews       ShariahReview[]
  documents            ProjectDocument[]
  teamMembers          ProjectTeamMember[]
  announcements        ProjectAnnouncement[]
  promotionCampaigns   ProjectPromotionCampaign[]
  ragDocuments         RagDocument[]
  milestones           ProjectMilestone[]
  lifecycleEvents      ProjectLifecycleEvent[]
  documentAnalyses     ProjectDocumentAnalysis[]
  dueDiligenceScans    ProjectDueDiligenceScan[]
  evidenceRequirements ProjectEvidenceRequirement[]
  feasibilityRevisions ProjectFeasibilityRevision[]
  approvals            ProjectApproval[]

  @@index([countryNodeId])
  @@index([organisationId])
  @@index([status])
}

model ProjectMilestone {
  id                 String    @id @default(cuid())
  projectId          String
  organisationId     String
  countryNodeId      String
  title              String
  targetDate         DateTime?
  completionPct      Int       @default(0)
  disbursementAmount Decimal   @default(0) @db.Decimal(18, 2)
  status             String    @default("UPCOMING")
  shariahSignoff     Boolean   @default(false)
  auditorSignoff     Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project      Project      @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode  @relation(fields: [countryNodeId], references: [code])

  @@index([projectId, status])
  @@index([organisationId, countryNodeId])
}

model ProjectLifecycleEvent {
  id             String   @id @default(cuid())
  projectId      String
  organisationId String
  countryNodeId  String
  fromStatus     String?
  toStatus       String
  note           String?
  actorId        String
  createdAt      DateTime @default(now())

  project      Project      @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode  @relation(fields: [countryNodeId], references: [code])

  @@index([projectId, createdAt])
  @@index([organisationId, countryNodeId, createdAt])
}

model ProjectTeamMember {
  id             String   @id @default(cuid())
  projectId      String
  userId         String
  organisationId String
  countryNodeId  String
  projectRole    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project      @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode  @relation(fields: [countryNodeId], references: [code])

  @@unique([projectId, userId])
  @@index([organisationId, countryNodeId])
}

model ProjectAnnouncement {
  id               String   @id @default(cuid())
  projectId        String
  organisationId   String
  countryNodeId    String
  authorId         String
  title            String
  body             String   @db.Text
  announcementType String
  publishedAt      DateTime @default(now())
  readCount        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project      Project      @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  organisation Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode  @relation(fields: [countryNodeId], references: [code])

  @@index([projectId, publishedAt])
  @@index([organisationId, countryNodeId])
}

model ProjectPromotionCampaign {
  id             String    @id @default(cuid())
  projectId      String
  organisationId String
  countryNodeId  String
  ownerId        String
  packageId      String
  packageName    String
  badgeType      String
  status         String
  startDate      DateTime
  endDate        DateTime?
  priceMYR       Decimal   @db.Decimal(18, 2)
  creditsCost    Int       @default(0)
  paymentMethod  String
  paymentStatus  String
  views          Int       @default(0)
  clicks         Int       @default(0)
  investorLeads  Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project      Project           @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  organisation Organisation      @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode       @relation(fields: [countryNodeId], references: [code])
  payment      PromotionPayment?

  @@index([projectId, status])
  @@index([organisationId, countryNodeId])
}

model PromotionPayment {
  id          String   @id @default(cuid())
  campaignId  String   @unique
  userId      String
  amountMYR   Decimal  @db.Decimal(18, 2)
  creditsCost Int      @default(0)
  method      String
  status      String
  providerRef String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign ProjectPromotionCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User                     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

model ProjectDocument {
  id               String   @id @default(cuid())
  projectId        String
  organisationId   String
  countryNodeId    String
  uploadedBy       String
  fileName         String
  mimeType         String
  fileSize         Int
  fileContent      Bytes
  extractedText    String   @db.Text
  extractionStatus String   @default("EXTRACTED")
  extractionError  String?
  /// SHA-256 of fileContent recorded at upload; a later mismatch means the stored file changed.
  sha256           String?
  /// Advisory tamper signals (see src/projects/document-integrity.ts).
  integrity        Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project              Project                      @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  organisation         Organisation                 @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode          CountryNode                  @relation(fields: [countryNodeId], references: [code])
  analyses             ProjectDocumentAnalysis[]
  evidenceRequirements ProjectEvidenceRequirement[] @relation("EvidenceDocument")

  @@index([projectId])
  @@index([organisationId, countryNodeId])
  @@index([extractionStatus])
  @@index([sha256])
}

model ProjectEvidenceRequirement {
  id                   String   @id @default(cuid())
  projectId            String
  organisationId       String
  countryNodeId        String
  evidenceType         String
  description          String
  requiredFormat       String
  priority             String
  status               String   @default("MISSING")
  uploadedDocumentId   String?
  verificationStatus   String   @default("NOT_STARTED")
  verificationResult   Json?
  confidenceScore      Int      @default(0)
  aiVerificationStatus String   @default("NOT_STARTED")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project          Project          @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  organisation     Organisation     @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode      CountryNode      @relation(fields: [countryNodeId], references: [code])
  uploadedDocument ProjectDocument? @relation("EvidenceDocument", fields: [uploadedDocumentId], references: [id], onDelete: SetNull)

  @@unique([projectId, evidenceType])
  @@index([organisationId, countryNodeId])
  @@index([projectId, status])
}

model ProjectDueDiligenceScan {
  id               String       @id @default(cuid())
  projectId        String
  organisationId   String
  countryNodeId    String
  requestedBy      String
  status           String       @default("COMPLETED")
  confidenceScore  Int          @default(0)
  missingDocuments Json
  findings         Json
  createdAt        DateTime     @default(now())
  completedAt      DateTime?
  project          Project      @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  organisation     Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode      CountryNode  @relation(fields: [countryNodeId], references: [code])

  @@index([projectId, createdAt])
  @@index([organisationId, countryNodeId, createdAt])
}

model ProjectDocumentAnalysis {
  id              String          @id @default(cuid())
  documentId      String
  projectId       String
  organisationId  String
  countryNodeId   String
  analysedBy      String
  confidenceScore Int
  result          Json
  createdAt       DateTime        @default(now())
  document        ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  project         Project         @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  organisation    Organisation    @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode     CountryNode     @relation(fields: [countryNodeId], references: [code])

  @@index([documentId, createdAt])
  @@index([projectId, createdAt])
}

model ProjectFeasibilityRevision {
  id                   String   @id @default(cuid())
  projectId            String
  organisationId       String
  countryNodeId        String
  aiRunId              String   @unique
  revisionNumber       Int
  supersedesRevisionId String?
  status               String   @default("PENDING_HUMAN_REVIEW")
  createdBy            String
  createdAt            DateTime @default(now())

  project            Project                      @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  organisation       Organisation                 @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode        CountryNode                  @relation(fields: [countryNodeId], references: [code])
  aiRun              AiRun                        @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  supersedesRevision ProjectFeasibilityRevision?  @relation("RevisionChain", fields: [supersedesRevisionId], references: [id])
  nextRevisions      ProjectFeasibilityRevision[] @relation("RevisionChain")
  approvals          ProjectApproval[]

  @@unique([projectId, revisionNumber])
  @@index([projectId, createdAt])
  @@index([organisationId, countryNodeId])
}

model ProjectApproval {
  id                 String    @id @default(cuid())
  projectId          String
  revisionId         String
  organisationId     String
  countryNodeId      String
  stage              String
  status             String    @default("PENDING")
  decision           String
  reviewerId         String
  reviewerRole       String
  comment            String
  supportingEvidence Json?
  decidedAt          DateTime  @default(now())
  supersededAt       DateTime?

  project      Project                    @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  revision     ProjectFeasibilityRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  organisation Organisation               @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode                @relation(fields: [countryNodeId], references: [code])

  @@index([projectId, status])
  @@index([revisionId, stage])
  @@index([organisationId, countryNodeId])
}

model WealthPool {
  poolId                   String   @id @default(cuid())
  poolName                 String
  currency                 String
  investmentStructure      String
  indicativeExpectedReturn Decimal  @db.Decimal(5, 2)
  status                   String   @default("OPEN")
  projectId                String
  organisationId           String
  countryNodeId            String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  project         Project          @relation(fields: [projectId], references: [projectId])
  organisation    Organisation     @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode     CountryNode      @relation(fields: [countryNodeId], references: [code])
  fundingRequests FundingRequest[]
  investmentOrders InvestmentOrder[]
  akadTerms       PoolAkadTerms[]

  @@index([countryNodeId])
  @@index([projectId])
}

model FundingRequest {
  fundingRequestId String    @id @default(cuid())
  projectId        String
  poolId           String?
  organisationId   String
  countryNodeId    String
  requestedAmount  Decimal   @db.Decimal(18, 2)
  currency         String    @default("USD")
  purpose          String    @default("Project funding")
  status           String    @default("PENDING") // PENDING | APPROVED | DISBURSED | REJECTED
  requestedBy      String
  requestedAt      DateTime  @default(now())
  approvedBy       String?
  approvedAt       DateTime?
  disbursedBy      String?
  disbursedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project       Project               @relation(fields: [projectId], references: [projectId])
  pool          WealthPool?           @relation(fields: [poolId], references: [poolId])
  organisation  Organisation          @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode   CountryNode           @relation(fields: [countryNodeId], references: [code])
  disbursements FundingDisbursement[]

  @@index([countryNodeId])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Append-only audit log
// ---------------------------------------------------------------------------

// Insert-only by application convention. CREATE TRIGGER blocks UPDATE/DELETE at
// the database layer (see prisma/migrations/*/migration.sql) so rows are
// tamper-evident even if the application or a client is compromised.
model AuditEvent {
  id             String   @id @default(cuid())
  userId         String
  userEmail      String?
  action         String // e.g. "funding.request", "project.create"
  resourceType   String // e.g. "FundingRequest", "Project"
  resourceId     String
  organisationId String?
  countryNodeId  String?
  result         String   @default("Success")
  metadata       Json
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  countryNode  CountryNode?  @relation(fields: [countryNodeId], references: [code])
  organisation Organisation? @relation(fields: [organisationId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([countryNodeId])
  @@index([createdAt])
}

// Global module switches are server-authoritative. Frontend visibility is only
// a convenience; protected API routes enforce the enabled state.
model FeatureModule {
  moduleKey   String   @id
  name        String
  description String
  mode        String   @default("ACTIVE")
  enabled     Boolean  @default(true)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiConversation {
  id             String      @id @default(cuid())
  userId         String
  organisationId String
  countryNodeId  String
  title          String?
  status         String      @default("ACTIVE")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  messages       AiMessage[]
  runs           AiRun[]

  @@index([userId, updatedAt])
  @@index([organisationId, countryNodeId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  citations      AiCitation[]

  @@index([conversationId, createdAt])
}

// A source cited by an AI assistant answer. Snapshots (title, pages, quote,
// excerpt) are kept because chunks can be rebuilt and documents superseded;
// chunkId/documentId link back while the source still exists.
model AiCitation {
  id             String       @id @default(cuid())
  messageId      String
  marker         Int
  sourceLabel    String
  chunkId        String?
  documentId     String?
  documentTitle  String
  sourceType     String
  scope          String
  pageStart      Int?
  pageEnd        Int?
  paragraphRefs  Json?
  quote          String?
  quoteVerified  Boolean      @default(false)
  excerpt        String       @db.Text
  retrievalScore Float?
  // Human review of the citation: UNREVIEWED | CONFIRMED | INCORRECT | IRRELEVANT.
  // The answer is never rewritten; flagged citations are shown with a warning.
  reviewStatus   String       @default("UNREVIEWED")
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewComment  String?
  createdAt      DateTime     @default(now())
  message        AiMessage    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chunk          RagChunk?    @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  document       RagDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([messageId, marker])
  @@index([documentId, createdAt])
  @@index([chunkId])
  @@index([reviewStatus, createdAt])
}

model AiRun {
  id                  String                      @id @default(cuid())
  requestId           String                      @unique
  featureKey          String
  action              String
  userId              String
  organisationId      String
  countryNodeId       String
  conversationId      String?
  input               Json
  output              Json?
  status              String                      @default("PENDING")
  provider            String
  model               String
  createdAt           DateTime                    @default(now())
  completedAt         DateTime?
  reviewStage         String                      @default("DRAFT")
  reviewHistory       Json?
  conversation        AiConversation?             @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  decision            AiDecision?
  feasibilityRevision ProjectFeasibilityRevision?

  @@index([organisationId, countryNodeId, createdAt])
  @@index([userId, createdAt])
  @@index([featureKey, status])
  @@index([featureKey, reviewStage])
}

model AiDecision {
  id            String   @id @default(cuid())
  runId         String   @unique
  decision      String
  justification String?
  reviewerId    String
  reviewerRole  String
  createdAt     DateTime @default(now())
  run           AiRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model RagDocument {
  id               String        @id @default(cuid())
  // GLOBAL (all D-8 country nodes) | COUNTRY (one country node) | PROJECT (one project). See src/ai/rag-scope.ts.
  scope            String        @default("PROJECT")
  // De-duplication key: "GLOBAL", the country code, or the project id.
  scopeKey         String
  // Owner tenant; for COUNTRY scope countryNodeId is the target country, for PROJECT it is the project tenant.
  organisationId   String
  countryNodeId    String
  uploadedBy       String
  projectId        String?
  title            String
  sourceType       String
  documentCategory String?
  contractType     String?
  authority        String?
  jurisdiction     String?
  industry         String?
  approvalStatus   String        @default("DRAFT") // DRAFT | REVIEWED | APPROVED | REJECTED
  reviewedBy       String?
  reviewedAt       DateTime?
  approvedBy       String?
  approvedAt       DateTime?
  reviewComment    String?
  contentHash      String
  status           String        @default("ACTIVE")
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  project          Project?      @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  chunks           RagChunk[]
  // Versioning: a superseded document is kept for audit and existing citations but is never retrieved again.
  supersededById   String?
  supersededAt     DateTime?
  effectiveFrom    DateTime?
  supersededBy     RagDocument?  @relation("RagSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes       RagDocument[] @relation("RagSupersession")
  citations        AiCitation[]

  @@unique([scope, scopeKey, contentHash])
  @@index([supersededById])
  @@index([scope, countryNodeId, approvalStatus, status])
  @@index([projectId, organisationId, countryNodeId, status])
  @@index([organisationId, countryNodeId, status])
  @@index([organisationId, countryNodeId, contractType, jurisdiction, approvalStatus])
}

model RagChunk {
