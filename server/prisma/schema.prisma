// Wealth Pooling - Prisma schema (PostgreSQL)
// Persistence layer for the backend API.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

// Mirror of the frontend UserRole union so the policy engine and IdP mapping
// share a single server-side source of truth.
enum UserRole {
  Super_Admin
  Country_Admin
  Organization_Admin
  Project_Sponsor
  Project_Manager
  Asset_Owner
  Asset_Manager
  Pool_Manager
  Retail_Investor
  HNWI_Investor
  Institutional_Investor
  Corporate_Investor
  Family_Office
  Portfolio_Manager
  Shariah_Advisor
  Shariah_Reviewer
  Shariah_Committee
  Compliance_Officer
  KYC_Officer
  KYB_Officer
  AML_Officer
  Risk_Officer
  Fraud_Analyst
  Legal_Officer
  Finance_Officer
  Treasury_Officer
  Settlement_Officer
  Reconciliation_Officer
  Auditor
  Customer_Support
  System_Administrator
  Security_Administrator
  Data_Administrator
  AI_Administrator
  AI_Model_Reviewer
  Guest
}

// Users are provisioned from the Identity Provider (Auth0 / Entra / Keycloak / Okta)
// via their OIDC subject identifier. This table stores the server-side profile and
// role mapping only; authentication is delegated to the IdP.
model User {
  id           String   @id @default(cuid())
  idpProvider  String // 'auth0' | 'azure' | 'keycloak' | 'okta'
  idpSubjectId String // OIDC `sub` claim
  email        String   @unique
  name         String
  isActive     Boolean  @default(true)
  profile      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // User can have multiple roles per organisation/country node
  roleAssignments UserRoleAssignment[]
  projectTeamMemberships ProjectTeamMember[]
  sponsoredProjects Project[]
  projectAnnouncements ProjectAnnouncement[]
  promotionCampaigns ProjectPromotionCampaign[]
  promotionPayments PromotionPayment[]
  sessions        Session[]
  createdContractTemplates ContractTemplate[]
  createdContractClauses ContractClause[]
  createdContractInputSchemas ContractInputSchema[]
  createdShariahRules ShariahRule[]
  createdDocumentVersions DocumentVersion[] @relation("DocumentVersionCreator")
  approvedDocumentVersions DocumentVersion[] @relation("DocumentVersionApprover")

  @@unique([idpProvider, idpSubjectId])
  @@index([email])
}

// User role assignments are scoped to a specific organisation and country node.
// A user can have multiple roles within a single org/country, or roles across multiple orgs.
model UserRoleAssignment {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           UserRole
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  countryNodeId  String
  countryNode    CountryNode  @relation(fields: [countryNodeId], references: [code], onDelete: Cascade)
  assignedBy     String // userId of the admin who made this assignment
  assignedAt     DateTime     @default(now())
  revokedBy      String?
  revokedAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, role, organisationId, countryNodeId])
  @@index([role])
  @@index([countryNodeId])
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model CountryNode {
  code                     String   @id
  name                     String
  currency                 String
  timezone                 String
  regulatoryProfile        String
  status                   String
  verificationStatus       String
  activeOrganisationsCount Int      @default(0)
  activeUsersCount         Int      @default(0)
  activeProjectsCount      Int      @default(0)
  activePoolsCount         Int      @default(0)
  flagUrl                  String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organisations       Organisation[]
  projects            Project[]
  pools               WealthPool[]
  contracts           Contract[]
  shariahReviews      ShariahReview[]
  auditEvents         AuditEvent[]
  fundingRequests     FundingRequest[]
  userRoleAssignments UserRoleAssignment[]
  projectDocuments    ProjectDocument[]
  projectTeamMembers  ProjectTeamMember[]
  projectAnnouncements ProjectAnnouncement[]
  promotionCampaigns  ProjectPromotionCampaign[]
  dueDiligenceScans   ProjectDueDiligenceScan[]
  documentAnalyses    ProjectDocumentAnalysis[]
  projectMilestones   ProjectMilestone[]
  lifecycleEvents     ProjectLifecycleEvent[]
  contractTemplates   ContractTemplate[]
  contractClauses     ContractClause[]
  contractInputSchemas ContractInputSchema[]
  shariahRules        ShariahRule[]
  documentVersions    DocumentVersion[]
}

model Organisation {
  id            String      @id @default(cuid())
  name          String
  countryNodeId String
  countryNode   CountryNode @relation(fields: [countryNodeId], references: [code])
  status        String      @default("ACTIVE")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  projects            Project[]
  pools               WealthPool[]
  auditEvents         AuditEvent[]
  userRoleAssignments UserRoleAssignment[]
  fundingRequests     FundingRequest[]
  contracts           Contract[]
  shariahReviews      ShariahReview[]
  projectDocuments    ProjectDocument[]
  projectTeamMembers  ProjectTeamMember[]
  projectAnnouncements ProjectAnnouncement[]
  promotionCampaigns  ProjectPromotionCampaign[]
  dueDiligenceScans   ProjectDueDiligenceScan[]
  documentAnalyses    ProjectDocumentAnalysis[]
  projectMilestones   ProjectMilestone[]
  lifecycleEvents     ProjectLifecycleEvent[]
  contractTemplates   ContractTemplate[]
  contractClauses     ContractClause[]
  contractInputSchemas ContractInputSchema[]
  shariahRules        ShariahRule[]
  documentVersions    DocumentVersion[]

  @@unique([id, countryNodeId])
  @@index([countryNodeId])
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------

model Project {
  projectId               String   @id @default(cuid())
  projectCode             String   @unique
  projectName             String
  description             String
  organisationId          String
  countryNodeId           String
  sector                  String
  totalProjectCost        Decimal  @db.Decimal(18, 2)
  sponsorContribution     Decimal  @db.Decimal(18, 2)
  fundingRequired         Decimal  @db.Decimal(18, 2)
  proposedShariahContract String
  sponsorEntityType       String?
  status                  String
  projectSponsorId        String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  lifecycleVersion        Int      @default(1)

  organisation    Organisation     @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode     CountryNode      @relation(fields: [countryNodeId], references: [code])
  projectSponsor  User             @relation(fields: [projectSponsorId], references: [id])
  pools           WealthPool[]
  fundingRequests FundingRequest[]
  shariahReviews  ShariahReview[]
  documents       ProjectDocument[]
  teamMembers     ProjectTeamMember[]
  announcements   ProjectAnnouncement[]
  promotionCampaigns ProjectPromotionCampaign[]
  ragDocuments     RagDocument[]
  milestones       ProjectMilestone[]
  lifecycleEvents  ProjectLifecycleEvent[]
  documentAnalyses ProjectDocumentAnalysis[]
  dueDiligenceScans ProjectDueDiligenceScan[]

  @@index([countryNodeId])
  @@index([organisationId])
  @@index([status])
}

model ProjectMilestone {
  id               String   @id @default(cuid())
  projectId        String
  organisationId   String
  countryNodeId    String
  title            String
  targetDate       DateTime?
  completionPct    Int      @default(0)
  disbursementAmount Decimal @db.Decimal(18, 2) @default(0)
  status           String   @default("UPCOMING")
  shariahSignoff  Boolean  @default(false)
  auditorSignoff  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project      Project      @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode  @relation(fields: [countryNodeId], references: [code])

  @@index([projectId, status])
  @@index([organisationId, countryNodeId])
}

model ProjectLifecycleEvent {
  id             String   @id @default(cuid())
  projectId      String
  organisationId String
  countryNodeId  String
  fromStatus     String?
  toStatus       String
  note           String?
  actorId        String
  createdAt      DateTime @default(now())

  project      Project      @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode  @relation(fields: [countryNodeId], references: [code])

  @@index([projectId, createdAt])
  @@index([organisationId, countryNodeId, createdAt])
}

model ProjectTeamMember {
  id             String   @id @default(cuid())
  projectId      String
  userId         String
  organisationId String
  countryNodeId  String
  projectRole    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project      @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode  @relation(fields: [countryNodeId], references: [code])

  @@unique([projectId, userId])
  @@index([organisationId, countryNodeId])
}

model ProjectAnnouncement {
  id               String   @id @default(cuid())
  projectId        String
  organisationId   String
  countryNodeId    String
  authorId         String
  title            String
  body             String   @db.Text
  announcementType String
  publishedAt      DateTime @default(now())
  readCount        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project      Project      @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  organisation Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode  @relation(fields: [countryNodeId], references: [code])

  @@index([projectId, publishedAt])
  @@index([organisationId, countryNodeId])
}

model ProjectPromotionCampaign {
  id             String   @id @default(cuid())
  projectId      String
  organisationId String
  countryNodeId  String
  ownerId        String
  packageId      String
  packageName    String
  badgeType      String
  status         String
  startDate      DateTime
  endDate        DateTime?
  priceMYR       Decimal  @db.Decimal(18, 2)
  creditsCost    Int      @default(0)
  paymentMethod  String
  paymentStatus  String
  views          Int      @default(0)
  clicks         Int      @default(0)
  investorLeads  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project      @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  organisation Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode  @relation(fields: [countryNodeId], references: [code])
  payment      PromotionPayment?

  @@index([projectId, status])
  @@index([organisationId, countryNodeId])
}

model PromotionPayment {
  id          String   @id @default(cuid())
  campaignId  String   @unique
  userId      String
  amountMYR   Decimal  @db.Decimal(18, 2)
  creditsCost Int      @default(0)
  method      String
  status      String
  providerRef String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign ProjectPromotionCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User                     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

model ProjectDocument {
  id                String   @id @default(cuid())
  projectId         String
  organisationId    String
  countryNodeId     String
  uploadedBy        String
  fileName          String
  mimeType          String
  fileSize          Int
  fileContent       Bytes
  extractedText     String   @db.Text
  extractionStatus  String   @default("EXTRACTED")
  extractionError   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project      Project     @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode @relation(fields: [countryNodeId], references: [code])
  analyses      ProjectDocumentAnalysis[]

  @@index([projectId])
  @@index([organisationId, countryNodeId])
  @@index([extractionStatus])
}

model ProjectDueDiligenceScan {
  id              String   @id @default(cuid())
  projectId       String
  organisationId  String
  countryNodeId   String
  requestedBy     String
  status          String   @default("COMPLETED")
  confidenceScore Int      @default(0)
  missingDocuments Json
  findings        Json
  createdAt       DateTime @default(now())
  completedAt     DateTime?
  project         Project  @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  organisation    Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode     CountryNode @relation(fields: [countryNodeId], references: [code])
  @@index([projectId, createdAt])
  @@index([organisationId, countryNodeId, createdAt])
}

model ProjectDocumentAnalysis {
  id           String   @id @default(cuid())
  documentId   String
  projectId    String
  organisationId String
  countryNodeId String
  analysedBy   String
  confidenceScore Int
  result       Json
  createdAt    DateTime @default(now())
  document     ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  project      Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode @relation(fields: [countryNodeId], references: [code])
  @@index([documentId, createdAt])
  @@index([projectId, createdAt])
}

model WealthPool {
  poolId                   String   @id @default(cuid())
  poolName                 String
  currency                 String
  investmentStructure      String
  indicativeExpectedReturn Decimal  @db.Decimal(5, 2)
  status                   String   @default("OPEN")
  projectId                String
  organisationId           String
  countryNodeId            String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  project         Project          @relation(fields: [projectId], references: [projectId])
  organisation    Organisation     @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode     CountryNode      @relation(fields: [countryNodeId], references: [code])
  fundingRequests FundingRequest[]

  @@index([countryNodeId])
  @@index([projectId])
}

model FundingRequest {
  fundingRequestId String    @id @default(cuid())
  projectId        String
  poolId           String?
  organisationId   String
  countryNodeId    String
  requestedAmount  Decimal   @db.Decimal(18, 2)
  currency         String    @default("USD")
  purpose          String    @default("Project funding")
  status           String    @default("PENDING") // PENDING | APPROVED | DISBURSED | REJECTED
  requestedBy      String
  requestedAt      DateTime  @default(now())
  approvedBy       String?
  approvedAt       DateTime?
  disbursedBy      String?
  disbursedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project      Project      @relation(fields: [projectId], references: [projectId])
  pool         WealthPool?  @relation(fields: [poolId], references: [poolId])
  organisation Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode  @relation(fields: [countryNodeId], references: [code])

  @@index([countryNodeId])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Append-only audit log
// ---------------------------------------------------------------------------

// Insert-only by application convention. CREATE TRIGGER blocks UPDATE/DELETE at
// the database layer (see prisma/migrations/*/migration.sql) so rows are
// tamper-evident even if the application or a client is compromised.
model AuditEvent {
  id             String   @id @default(cuid())
  userId         String
  userEmail      String?
  action         String // e.g. "funding.request", "project.create"
  resourceType   String // e.g. "FundingRequest", "Project"
  resourceId     String
  organisationId String?
  countryNodeId  String?
  result         String   @default("Success")
  metadata       Json
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  countryNode  CountryNode?  @relation(fields: [countryNodeId], references: [code])
  organisation Organisation? @relation(fields: [organisationId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([countryNodeId])
  @@index([createdAt])
}

// Global module switches are server-authoritative. Frontend visibility is only
// a convenience; protected API routes enforce the enabled state.
model FeatureModule {
  moduleKey   String   @id
  name        String
  description String
  mode        String   @default("ACTIVE")
  enabled     Boolean  @default(true)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiConversation {
  id             String      @id @default(cuid())
  userId         String
  organisationId String
  countryNodeId  String
  title          String?
  status         String      @default("ACTIVE")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  messages       AiMessage[]
  runs           AiRun[]

  @@index([userId, updatedAt])
  @@index([organisationId, countryNodeId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AiRun {
  id             String         @id @default(cuid())
  requestId      String         @unique
  featureKey     String
  action         String
  userId         String
  organisationId String
  countryNodeId  String
  conversationId String?
  input          Json
  output         Json?
  status         String         @default("PENDING")
  provider       String
  model          String
  createdAt      DateTime       @default(now())
  completedAt    DateTime?
  reviewStage    String         @default("DRAFT")
  reviewHistory  Json?
  conversation   AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  decision       AiDecision?

  @@index([organisationId, countryNodeId, createdAt])
  @@index([userId, createdAt])
  @@index([featureKey, status])
}

model AiDecision {
  id           String   @id @default(cuid())
  runId        String   @unique
  decision     String
  justification String?
  reviewerId   String
  reviewerRole String
  createdAt    DateTime @default(now())
  run          AiRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model RagDocument {
  id             String      @id @default(cuid())
  organisationId String
  countryNodeId  String
  uploadedBy     String
  projectId      String?
  title          String
  sourceType     String
  documentCategory String?
  contractType   String?
  authority      String?
  jurisdiction   String?
  industry       String?
  approvalStatus String   @default("DRAFT")
  contentHash    String
  status         String      @default("ACTIVE")
  metadata       Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  project        Project?    @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  chunks         RagChunk[]

  @@unique([organisationId, countryNodeId, contentHash])
  @@index([projectId, organisationId, countryNodeId, status])
  @@index([organisationId, countryNodeId, status])
  @@index([organisationId, countryNodeId, contractType, jurisdiction, approvalStatus])
}

model RagChunk {
  id         String      @id @default(cuid())
  documentId String
  chunkIndex Int
  content    String
  metadata   Json?
  createdAt  DateTime    @default(now())
  document   RagDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

// Server-owned zakat calculation snapshots.
model ZakatCalculation {
  id              String   @id @default(cuid())
  userId          String
  currency        String   @default("USD")
  investedCapital Decimal  @db.Decimal(18, 2)
  liquidCash      Decimal  @db.Decimal(18, 2)
  debtsOwed       Decimal  @db.Decimal(18, 2)
  nisabThreshold  Decimal  @db.Decimal(18, 2)
  zakatRate       Decimal  @db.Decimal(5, 4)
  netWealth       Decimal  @db.Decimal(18, 2)
  zakatDue        Decimal  @db.Decimal(18, 2)
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

// Membership state is keyed by the authenticated identity subject because
// OIDC users may not yet have a local User row.
model MembershipSubscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  planId               String
  tier                 String
  billingInterval      String
  status               String   @default("Active")
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  autoRenew            Boolean  @default(true)
  paymentMethodSummary String   @default("Simulated Payment Gateway")
  aiCreditsRemaining   Int
  aiCreditsTotal       Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  creditTransactions   AiCreditTransaction[]
}

model AiCreditTransaction {
  id             String   @id @default(cuid())
  userId         String
  subscriptionId String
  type           String
  operationKey   String?
  targetEntity   String?
  credits        Int
  balanceBefore  Int
  balanceAfter   Int
  amountMYR      Decimal? @db.Decimal(18, 2)
  paymentMethod  String?
  reference      String?
  createdAt      DateTime @default(now())
  subscription   MembershipSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

// Authoritative AI credit wallet. Legacy MembershipSubscription and
// AiCreditTransaction rows remain for compatibility with existing billing data.
model AiCreditWallet {
  id                String   @id @default(cuid())
  userId            String
  organisationId    String
  subscriptionPlan  String
  monthlyAllowance  Int      @default(0)
  purchasedCredits  Int      @default(0)
  bonusCredits      Int      @default(0)
  usedCredits       Int      @default(0)
  availableBalance  Int      @default(0)
  resetDate         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, organisationId])
  @@index([organisationId, updatedAt])
}

model AiCapabilityPricing {
  id              String   @id @default(cuid())
  operationKey    String   @unique
  featureType     String
  operationName   String
  creditsRequired Int
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AiUsageTransaction {
  id              String   @id @default(cuid())
  userId          String
  organisationId  String
  featureType     String
  operationName   String
  creditsConsumed Int
  projectId       String?
  timestamp       DateTime @default(now())
  status          String

  @@index([userId, timestamp])
  @@index([organisationId, timestamp])
  @@index([featureType, timestamp])
}

model MembershipBillingRecord {
  id              String   @id @default(cuid())
  userId          String
  invoiceNumber   String   @unique
  planId          String
  billingInterval String
  amountMYR       Decimal  @db.Decimal(18, 2)
  amountUSD       Decimal  @db.Decimal(18, 2)
  status          String   @default("Paid")
  paymentMethod   String
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

model PdpApplication {
  id                String    @id @default(cuid())
  applicationNumber String    @unique
  userId            String
  userEmail         String
  countryCode       String
  countryName       String
  organisationName  String
  pdpType           String
  status            String    @default("DRAFT")
  kybStatus         String    @default("IN_PROGRESS")
  payload           Json
  submittedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([countryCode, status])
}

// ---------------------------------------------------------------------------
// Shariah governance review and human signoff
// ---------------------------------------------------------------------------

model ShariahReview {
  id                String   @id @default(cuid())
  projectId         String
  organisationId    String
  countryNodeId     String
  proposedContract  String
  status            String   @default("PROPOSED") // PROPOSED | UNDER_REVIEW | CHANGES_REQUESTED | APPROVED | MODIFIED | OVERRIDDEN | REJECTED | REVERTED
  aiResult          Json?
  confidence        Decimal? @db.Decimal(5, 2)
  createdBy         String
  revision          Int      @default(1)
  parentReviewId    String?
  requestedChanges  String?
  submittedAt       DateTime @default(now())
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project     Project            @relation(fields: [projectId], references: [projectId])
  decisions  ShariahDecision[]
  parentReview ShariahReview? @relation("ShariahReviewRevisions", fields: [parentReviewId], references: [id])
  childReviews ShariahReview[] @relation("ShariahReviewRevisions")
  organisation Organisation      @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode CountryNode        @relation(fields: [countryNodeId], references: [code])

  @@index([projectId])
  @@index([organisationId, countryNodeId])
  @@index([status])
  @@index([projectId, status])
}

model ShariahDecision {
  id            String   @id @default(cuid())
  reviewId      String
  decision      String   // ACCEPTED | MODIFIED | OVERRIDDEN | REJECTED
  justification String?
  actorId       String
  actorRole     String
  createdAt     DateTime @default(now())

  review ShariahReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, createdAt])
}

model Notification {
  id             String   @id @default(cuid())
  recipientUserId String
  organisationId String
  countryNodeId  String
  type           String
  title          String
  message        String
  resourceType   String?
  resourceId     String?
  readAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([recipientUserId, readAt, createdAt])
  @@index([organisationId, countryNodeId, createdAt])
}

// ---------------------------------------------------------------------------
// Month 1 contract and session foundation
// ---------------------------------------------------------------------------

model Contract {
  id             String   @id @default(cuid())
  contractNumber String   @unique
  contractType   String
  title          String?
  templateId     String?
  status         String   @default("DRAFT")
  wizardData     Json?
  complianceReport Json?
  lastGeneratedAt DateTime?
  organisationId String
  countryNodeId  String
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation       @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode        @relation(fields: [countryNodeId], references: [code])
  versions     ContractVersion[]
  parties      ContractParty[]
  approvals    ContractApproval[]
  events       ContractEvent[]
  documentVersions DocumentVersion[]

  @@index([organisationId, countryNodeId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Contract Intelligence Engine foundation
// ---------------------------------------------------------------------------

model ContractTemplate {
  id             String   @id @default(cuid())
  organisationId String
  countryNodeId  String
  contractType   String
  templateName   String
  jurisdiction   String
  industry       String
  version        Int      @default(1)
  status         String   @default("ACTIVE")
  approvalStatus String   @default("PENDING")
  createdBy      String
  createdDate    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode  @relation(fields: [countryNodeId], references: [code])
  creator      User         @relation(fields: [createdBy], references: [id])
  clauses      ContractClause[]

  @@unique([organisationId, countryNodeId, contractType, templateName, version])
  @@index([organisationId, countryNodeId, contractType, approvalStatus])
  @@index([jurisdiction, industry])
}

model ContractClause {
  id              String   @id @default(cuid())
  organisationId  String
  countryNodeId   String
  templateId      String?
  contractType    String
  industry        String?
  clauseCategory  String
  clauseTitle     String
  clauseText      String   @db.Text
  shariahReference String?
  jurisdiction    String
  riskLevel       String   @default("MEDIUM")
  approvalStatus  String   @default("PENDING")
  createdBy       String
  createdDate     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode  @relation(fields: [countryNodeId], references: [code])
  template     ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  creator      User @relation(fields: [createdBy], references: [id])

  @@index([organisationId, countryNodeId, contractType, approvalStatus])
  @@index([templateId])
}

model ContractInputSchema {
  id             String   @id @default(cuid())
  organisationId String
  countryNodeId  String
  contractType   String
  schemaName     String
  version        Int      @default(1)
  requiredFields Json
  status         String   @default("ACTIVE")
  approvalStatus String   @default("PENDING")
  createdBy      String
  createdDate    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode @relation(fields: [countryNodeId], references: [code])
  creator      User @relation(fields: [createdBy], references: [id])

  @@unique([organisationId, countryNodeId, contractType, schemaName, version])
  @@index([organisationId, countryNodeId, contractType, approvalStatus])
}

model ShariahRule {
  id              String   @id @default(cuid())
  organisationId  String
  countryNodeId   String
  contractType    String
  jurisdiction    String?
  ruleName        String
  description     String   @db.Text
  severity        String   @default("MEDIUM")
  validationLogic String   @db.Text
  approvalStatus  String   @default("PENDING")
  createdBy       String
  createdDate     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode @relation(fields: [countryNodeId], references: [code])
  creator      User @relation(fields: [createdBy], references: [id])

  @@unique([organisationId, countryNodeId, contractType, ruleName])
  @@index([organisationId, countryNodeId, contractType, severity, approvalStatus])
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  organisationId String
  countryNodeId String
  version      Int
  createdBy    String
  reviewStatus String   @default("DRAFT")
  approvedBy   String?
  createdDate  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  document     Contract @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId, countryNodeId], references: [id, countryNodeId])
  countryNode  CountryNode @relation(fields: [countryNodeId], references: [code])
  creator      User @relation("DocumentVersionCreator", fields: [createdBy], references: [id])
  approver     User? @relation("DocumentVersionApprover", fields: [approvedBy], references: [id])

  @@unique([documentId, version])
  @@index([organisationId, countryNodeId, reviewStatus])
  @@index([documentId, createdDate])
}

model ContractVersion {
  id         String   @id @default(cuid())
  contractId String
  version    Int
  content    Json
  status     String   @default("DRAFT")
  createdBy  String
  createdAt  DateTime @default(now())

  contract  Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  approvals ContractApproval[]

  @@unique([contractId, version])
}

model ContractParty {
  id             String   @id @default(cuid())
  contractId     String
  partyType      String
  displayName    String
  userId         String?
  organisationId String?
  createdAt      DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model ContractApproval {
  id           String    @id @default(cuid())
  contractId   String
  versionId    String
  approverId   String
  status       String    @default("PENDING")
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())

  contract Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  version  ContractVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([contractId, status])
}

model ContractEvent {
  id         String   @id @default(cuid())
  contractId String
  eventType  String
  fromStatus String?
  toStatus   String?
  actorId    String
  metadata   Json
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, createdAt])
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  activeRole     UserRole?
  countryNodeId  String
  organisationId String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}
