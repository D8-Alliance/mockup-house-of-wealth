# Copy to server/.env.production and fill from your secret manager.
NODE_ENV=production
AUTH_MODE=oidc
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/house_of_wealth
DEFAULT_COUNTRY_NODE=CN-MYS
DEFAULT_ORGANISATION=ORG-PUBLIC

# Redis service name inside the production compose network.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD_FILE=/run/secrets/redis_password
REDIS_PASSWORD=
REDIS_TLS=true
REDIS_CA_CERT_FILE=/run/redis-certs/ca.crt
WORKER_ENABLED=true
WORKER_CONCURRENCY=4

# Required payout security secrets.
PAYOUT_DESTINATION_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_SECRET
PAYOUT_WEBHOOK_SECRET=REPLACE_WITH_HIGH_ENTROPY_SECRET

# Notification providers. Keep unset until accounts and consent policy are ready.
NOTIFICATION_EMAIL_PROVIDER=
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
NOTIFICATION_EMAIL_FROM=verified-sender@example.com
NOTIFICATION_SMS_PROVIDER=
TWILIO_ACCOUNT_SID=REPLACE_WITH_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=REPLACE_WITH_TWILIO_NUMBER
NOTIFICATION_PUSH_PROVIDER=
FCM_SERVER_KEY=REPLACE_WITH_FCM_SERVER_KEY
NOTIFICATION_DEFAULT_CHANNELS=IN_APP

# Select only after legal/compliance approval and provider contract.
PAYOUT_PROVIDER=UNCONFIGURED
PAYOUT_PROVIDER_BASE_URL=
PAYOUT_PROVIDER_API_KEY=
