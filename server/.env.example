# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/house_of_wealth_local"

# Authentication Mode
# 'mock' for development/testing, 'oidc' for Keycloak
AUTH_MODE=mock

# AI provider. Leave empty to use the sandbox provider.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Optional OpenAI-compatible endpoint.
OPENAI_API_URL="https://api.openai.com/v1/chat/completions"
# RAG embeddings via an OpenAI-compatible /embeddings endpoint, 768 dimensions (see src/ai/rag-embedding.service.ts).
# OpenAI: text-embedding-3-small. Ollama: nomic-embed-text (ollama pull nomic-embed-text). Empty = keyword search only.
RAG_EMBEDDING_MODEL="text-embedding-3-small"
# RAG_EMBEDDING_API_URL defaults to OPENAI_API_URL with /chat/completions replaced by /embeddings.
# Minimum cosine similarity for vector results (model-specific; 0.55 suits nomic-embed-text).
# RAG_MIN_VECTOR_SIMILARITY=0.55
# AI assistant: sources per answer, output token cap, and request timeout (local CPU models are slow).
# AI_CHAT_MAX_SOURCES=4
# AI_CHAT_MAX_TOKENS=800
# AI_CHAT_TIMEOUT_MS=240000



# Alternative: Use PEM-encoded public key instead of JWKS_URI
# OIDC_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n....\n-----END PUBLIC KEY-----"

# OIDC Shared Secret (for HS256 dev mode)
# JWT_SHARED_SECRET=your-shared-secret-key

# Defaults when IdP does not return tenant/org info
DEFAULT_COUNTRY_NODE=CN-MYS
DEFAULT_ORGANISATION=ORG-PUBLIC

# Server Port
PORT=3001

# ToyyibPay (leave empty to keep the existing simulator flows)
TOYYIBPAY_BASE_URL=
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_CALLBACK_URL=
TOYYIBPAY_RETURN_URL=
# Simulated (non-ToyyibPay) payments grant credits/plans without charging anyone.
# They are always refused when NODE_ENV=production unless this is set to true.
ALLOW_SIMULATED_PAYMENTS=
# RM value of one purchased AI credit when paying for membership (default 0.20).
# Keep it below the cheapest pack price per credit (RM 899 / 3,600 ≈ 0.25) to avoid arbitrage.
MEMBERSHIP_CREDIT_VALUE_MYR=

# Payout security. Use independent high-entropy secrets in deployment secret storage.
PAYOUT_DESTINATION_ENCRYPTION_KEY=
PAYOUT_WEBHOOK_SECRET=

# Local Redis defaults. Production uses server/.env.production.example.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD_FILE=ops/secrets/redis_password
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_CA_CERT_FILE=
WORKER_ENABLED=false
WORKER_CONCURRENCY=2

# Required payout security secrets.
PAYOUT_DESTINATION_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_SECRET
PAYOUT_WEBHOOK_SECRET=REPLACE_WITH_HIGH_ENTROPY_SECRET

# Notification providers. Keep unset until accounts and consent policy are ready.
NOTIFICATION_EMAIL_PROVIDER=
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
NOTIFICATION_EMAIL_FROM=verified-sender@example.com
NOTIFICATION_SMS_PROVIDER=
TWILIO_ACCOUNT_SID=REPLACE_WITH_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=REPLACE_WITH_TWILIO_NUMBER
NOTIFICATION_PUSH_PROVIDER=
# Push uses the FCM HTTP v1 API with a Firebase service account key (the legacy FCM_SERVER_KEY API is retired).
# Set NOTIFICATION_PUSH_PROVIDER=fcm and point this at the JSON key; never commit the key file.
FCM_SERVICE_ACCOUNT_FILE=ops/secrets/firebase-service-account.json
NOTIFICATION_DEFAULT_CHANNELS=IN_APP

# Environment
NODE_ENV=development

# KYC automated checks (advisory; officers still decide). See src/kyc/checks/check-routing.ts.
# Empty = internal rules only (DOCUMENT_CONSISTENCY, DUPLICATE_IDENTITY). Unknown fields are rejected at start-up.
# Example: {"defaults":{"AML_SCREENING":{"primary":"vendor-a","required":true}},"countries":{"CN-MYS":{"DOCUMENT":{"primary":"vendor-a","shadow":["mock"],"required":true}}}}
KYC_ROUTING_JSON=
# Base URL providers call back on (webhooks go to /kyc/webhooks/<provider>)
PUBLIC_API_BASE_URL=
# Commercial eKYC vendor template (src/kyc/checks/providers/http-vendor.provider.ts); active only when all three are set
KYC_VENDOR_A_URL=
KYC_VENDOR_A_KEY=
KYC_VENDOR_A_WEBHOOK_SECRET=
KYC_VENDOR_A_CHECKS=DOCUMENT,LIVENESS,FACE_MATCH,AML_SCREENING
KYC_VENDOR_A_COUNTRIES=CN-MYS
# In-house eKYC ML service (provider "inhouse-ml": DOCUMENT and FACE_MATCH; no LIVENESS).
# Run the service with MEDIA_BACKEND=local and MEDIA_ROOT pointing at the same directory as KYC_ML_MEDIA_DIR.
KYC_ML_URL=
KYC_ML_MEDIA_DIR=
# KYC face verification (camera liveness prototype). Models: run "npm run models:download" once.
# true = applicants must pass face verification before submitting KYC.
KYC_REQUIRE_LIVENESS=false
