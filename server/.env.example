# Database
DATABASE_URL="postgresql://user:password@localhost:5432/house_of_wealth"

# Authentication Mode
# 'mock' for development/testing, 'oidc' for Keycloak
AUTH_MODE=mock

# OIDC Configuration (for AUTH_MODE=oidc)
OIDC_ISSUER=http://45.127.7.141:8080/realms/house-of-wealth
OIDC_AUDIENCE=house-of-wealth-api
OIDC_JWKS_URI=http://45.127.7.141:8080/realms/house-of-wealth/protocol/openid-connect/certs

# Alternative: Use PEM-encoded public key instead of JWKS_URI
# OIDC_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n....\n-----END PUBLIC KEY-----"

# OIDC Shared Secret (for HS256 dev mode)
# JWT_SHARED_SECRET=your-shared-secret-key

# Defaults when IdP does not return tenant/org info
DEFAULT_COUNTRY_NODE=CN-MYS
DEFAULT_ORGANISATION=ORG-PUBLIC

# Server Port
PORT=3001

# Environment
NODE_ENV=development
