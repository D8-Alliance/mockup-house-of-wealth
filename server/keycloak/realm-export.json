{
  "realm": "house-of-wealth",
  "enabled": true,
  "displayName": "Wealth Pooling D-8",
  "loginTheme": "house-of-wealth",
  "sslRequired": "NONE",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "clients": [
    {
      "clientId": "house-of-wealth-web",
      "name": "House of Wealth Web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "house-of-wealth-api",
            "access.token.claim": "true"
          }
        },
        {
          "name": "country-node-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "country_node_id",
            "claim.name": "country_node_id",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        },
        {
          "name": "organisation-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "organisation_id",
            "claim.name": "organisation_id",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        },
        {
          "name": "app-role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "app_role",
            "claim.name": "role",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        },
        {
          "name": "authentication-method-reference",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
